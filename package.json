{
  "name": "antigravity-chinese",
  "version": "3.2.24",
  "description": "Google Antigravity 2.0 桌面客户端轻量级中文汉化工具包 (Cross-Platform Localization Tool for Google Antigravity)",
  "main": "cli.js",
  "engines": {
    "node": ">=16.0.0"
  },
  "bin": {
    "antigravity-cn": "./cli.js"
  },
  "scripts": {
    "test": "node test/test-lint.js && node test/verify.js && node test/test-screenshots.js && node test/test-menu-and-titles.js && node test/test-asar-lifecycle.js && node test/test-detector-live.js && node test/test-proofread-integrity.js",
    "test:verify": "node test/verify.js",
    "test:screenshots": "node test/test-screenshots.js",
    "test:menus": "node test/test-menu-and-titles.js",
    "test:asar": "node test/test-asar-lifecycle.js",
    "test:detector": "node test/test-detector-live.js",
    "test:proofread": "node test/test-proofread-integrity.js",
    "scan:drift": "node tools/drift-detector.js",
    "status": "node cli.js status",
    "install-patch": "node cli.js install",
    "install:plugin": "node cli.js install-plugin",
    "uninstall:plugin": "node cli.js uninstall-plugin",
    "launch": "node cli.js launch",
    "restore": "node cli.js restore"
  },
  "keywords": [
    "antigravity",
    "google-antigravity",
    "localization",
    "chinese",
    "electron",
    "i18n",
    "zh-cn"
  ],
  "author": "Antigravity Open Source Community",
  "license": "MIT",
  "devDependencies": {
    "@electron/asar": "3.2.14",
    "jsdom": "^22.1.0"
  }
}
